# Terraform — never commit real secrets or state
terraform/terraform.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.tfstate.lock.info

# OS
.DS_Store
Thumbs.db

# Legal notices copied in at image build time;
# generated by CI, not checked in.
backend/legal/*
!backend/legal/.gitkeep
frontend/legal/*
!frontend/legal/.gitkeep
